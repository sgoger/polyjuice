{
  "name": "polyjuice",
  "version": "0.1.0",
  "private": true,
  "description": "Pseudonymisation de documents bureautiques, 100 % dans le navigateur",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test",
    "fixtures": "TZ=UTC tsx scripts/make-fixtures.ts",
    "test:e2e:slow": "E2E_SLOW=1 playwright test --grep @slow"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@xmldom/xmldom": "^0.9.12",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "docx": "^9.15.3",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "exceljs": "^4.4.0",
    "globals": "^17.14.0",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "image-size": "^2.0.3",
    "uuid": "^11.1.1"
  }
}
